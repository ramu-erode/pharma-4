# Development defaults. The only place defaults for credentials may live.
# Copy to .env to override; .env is git-ignored.
# Compose loads this file and then .env (if present) into every container.

# --- MQTT: one user per service (see mosquitto/acl) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PASSWORD_SIMULATOR=dev-simulator
MQTT_PASSWORD_EDGE_ADAPTER=dev-edge-adapter
MQTT_PASSWORD_HISTORIAN=dev-historian
MQTT_PASSWORD_GRAPH_SYNC=dev-graph-sync
MQTT_PASSWORD_ANOMALY=dev-anomaly
MQTT_PASSWORD_YIELD=dev-yield
MQTT_PASSWORD_DASHBOARD=dev-dashboard
MQTT_PASSWORD_HEALTHCHECK=dev-healthcheck
# Read-only user for MQTT Explorer and local debugging.
MQTT_PASSWORD_EXPLORER=dev-explorer

# --- TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pharma
POSTGRES_USER=pharma
POSTGRES_PASSWORD=dev-postgres

# --- Neo4j ---
# The neo4j image turns every NEO4J_* variable into a server setting, so only
# NEO4J_AUTH (which it reads specially) may use that prefix. Clients use BOLT_URI.
BOLT_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/dev-neo4j-password

# --- Simulation (ADR-0009) ---
SEED=42
SIM_SPEED=3600
INTEGRATION_STEP_S=5
PUBLISH_PERIOD_S=60
DEADBAND_FLOOR_S=600
HEARTBEAT_WALL_S=30
BACKFILL_BATCHES=200

# --- Models ---
MODELS_DIR=models
